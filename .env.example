# Copy to .env and fill ONLY the provider you use. Never commit .env.
# Use a model ID available in your own provider account.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# ARTICRAFT_PROVIDER=openrouter
# ARTICRAFT_OPENROUTER_MODEL=
# ARTICRAFT_MODEL=
# ARTICRAFT_REASONING_EFFORT=low
# ARTICRAFT_COMPILE_TIMEOUT_SECONDS=900
# ARTICRAFT_OPENROUTER_REQUEST_TIMEOUT_SECONDS=180
# NO_PROXY=127.0.0.1,localhost,::1
# no_proxy=127.0.0.1,localhost,::1
